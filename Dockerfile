# ---------- Этап 1: Сборка (Builder) ----------
# Берем официальный образ с Go. Он тяжелый, но это не страшно.
FROM golang:1.26-alpine AS builder

WORKDIR /app

# 1. Копируем ТОЛЬКО файлы зависимостей ПЕРВЫМИ.
# Это главный секрет скорости. Если вы не меняли go.mod/go.sum, 
# Docker возьмет этот слой из кэша и не будет заново качать Gin.
COPY go.mod go.sum ./
RUN go mod download

# 2. Теперь копируем исходный код
COPY . .

# 3. Собираем бинарник.
# CGO_ENABLED=0 — отключает C-зависимости (делает бинарник "чистым" для Linux).
# -ldflags="-s -w" — удаляет отладочную информацию, уменьшая размер файла.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o main ./cmd/app

# ---------- Этап 2: Запуск (Runner) ----------
# Берем абсолютно пустой образ (или Alpine, если нужны сертификаты).
# В нем нет шелла, компилятора и вообще ничего, кроме вашего кода.
FROM scratch

# Если ваше приложение делает запросы в интернет по HTTPS (например, к API),
# ему нужны корневые сертификаты. 
# Если приложение автономное — эту строку можно удалить.
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Копируем готовый бинарник из первого этапа в корень второго
COPY --from=builder /app/main /main

# Запускаем его
ENTRYPOINT ["/main"]