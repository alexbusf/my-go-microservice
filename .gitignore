# Игнорируем папку настроек VS Code 
.vscode/ 
# Но оставим настройки форматирования (чтобы у всех был одинаковый стиль) 
!.vscode/settings.json 
# И настройки запуска (чтобы можно было дебажить) 
!.vscode/launch.json

# Бинарники Go
main
cmd/api/main
*.exe

# Папка с бинарниками Go
/bin/
/obj/

# Профили производительности
cpu.out
mem.out

# Переменные окружения с секретами
.env
.env.* 

# Системный мусор (Windows)
Thumbs.db
Desktop.ini

# Папка с миграциями (мы храним только структуру, а не данные)
# Если хочешь хранить миграции в Git, закомментируй эти строки:
# db/migrations/*.db
# db/migrations/goose.*

# Папка с данными PostgreSQL (если бы она была локальной)
# data/